# Betterway Mortgages LLC — Corporate Operating System (.env.example)
# Copy to .env.local (development) or configure in your production secrets manager.

# =====================================================================
# 1. REQUIRED CRYPTOGRAPHIC SECRETS (Generate via `openssl rand -hex 32`)
# =====================================================================
BW_SESSION_SECRET=replace-with-64-char-hex-session-secret
BW_VAULT_MASTER_KEY=replace-with-64-char-hex-aes256-gcm-key
BW_INTAKE_HMAC_SECRET=replace-with-64-char-hex-webhook-hmac-secret

# =====================================================================
# 2. INITIAL STAFF PASSWORDS (Used on first production database bootstrap)
# =====================================================================
OWNER_PASSWORD=replace-with-strong-owner-password
ADMIN_PASSWORD=replace-with-strong-admin-password
STAFF_DEFAULT_PASSWORD=replace-with-strong-initial-staff-password

# =====================================================================
# 3. STORAGE & PERSISTENCE (Persistent disk recommended outside Vercel)
# =====================================================================
# Directory for SQLite database, encrypted document vault, and backups.
BW_OS_DATA_DIR=/var/lib/betterway-os
# Optional explicit SQLite file path override
# BW_OS_DB_PATH=/var/lib/betterway-os/betterway-os.sqlite

# =====================================================================
# 4. CROSS-ORIGIN & PUBLIC WEBSITE INTERCONNECTION
# =====================================================================
BW_PUBLIC_SITE_ORIGIN=https://betterwaymortgages.vercel.app

# =====================================================================
# 5. OPTIONAL INTEGRATIONS (CBUAE EIBOR, WhatsApp Cloud API)
# =====================================================================
# CBUAE_EIBOR_API_URL=https://www.centralbank.ae/umbraco/surface/eibor/GetEiborData
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
